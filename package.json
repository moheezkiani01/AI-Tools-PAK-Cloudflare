{
  "name": "ai-tools-pak",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "node scripts/start.mjs --dev",
    "start": "node scripts/start.mjs",
    "build": "vite build && node scripts/prerender.mjs",
    "test": "node scripts/run-tests.mjs",
    "test:screens": "node scripts/screen-check.mjs",
    "orders": "npm --prefix server run orders",
    "add-token": "npm --prefix server run add-token",
    "predev": "node scripts/logo-manifest.mjs",
    "prebuild": "node scripts/logo-manifest.mjs",
    "backup": "node scripts/backup.mjs",
    "cloudflare:check": "npm run build && npx --yes wrangler@4 deploy --dry-run",
    "cloudflare:dev": "npm run build && npx --yes wrangler@4 dev --env-file=./server/.env",
    "cloudflare:deploy": "npm run build && npx --yes wrangler@4 deploy --secrets-file=./server/.env"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.3.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "tailwindcss": "^4.0.0",
    "vite": "^6.0.0"
  }
}
