# Copy this file to ".env" (same folder) and fill it in. Never share the .env file with anyone.

# Password for the admin page at /admin (choose a long one)
ADMIN_PASSWORD=

# Required on Vercel; optional for local cloud testing.
# Supabase Project URL: https://YOUR-PROJECT.supabase.co
# Supabase API Keys > Secret key (starts sb_secret_). SERVER ONLY.
SUPABASE_URL=
SUPABASE_SECRET_KEY=

# Optional: email customers when their question is answered.
# With Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, SMTP_USER=your address, SMTP_PASS=an "App password".
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=

# Optional scaling path for HIGH checkout concurrency.
# Leave FALSE until supabase/optional_checkout_scaling.sql has been
# applied to a STAGING project and both new and legacy orders are tested.
# This requires persistent Supabase; local JSON does not support it.
ORDER_STORAGE_V2=false
